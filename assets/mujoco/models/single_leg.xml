<mujoco model="single_leg">
    <compiler angle="degree" autolimits="true"/>

    <option
        timestep="0.002"
        gravity="0 0 -9.81"
        integrator="implicitfast"/>

    <default>
        <joint
            damping="1.0"
            armature="0.02"/>

        <geom
            type="capsule"
            density="500"
            friction="0.8 0.1 0.1"
            rgba="0.25 0.55 0.85 1"/>
    </default>

    <worldbody>
        <light
            pos="0 0 3"
            dir="0 0 -1"/>

        <geom
            name="floor"
            type="plane"
            size="3 3 0.1"
            rgba="0.85 0.85 0.85 1"/>

        <body
            name="support"
            pos="0 0 1.5">

            <geom
                name="support_geom"
                type="box"
                size="0.12 0.12 0.12"
                mass="2"
                rgba="0.2 0.2 0.2 1"/>

            <body
                name="upper_leg"
                pos="0 0 -0.12">

                <joint
                    name="hip_joint"
                    type="hinge"
                    axis="0 1 0"
                    range="-70 70"/>

                <geom
                    name="upper_leg_geom"
                    fromto="0 0 0 0 0 -0.5"
                    size="0.07"/>

                <body
                    name="lower_leg"
                    pos="0 0 -0.5">

                    <joint
                        name="knee_joint"
                        type="hinge"
                        axis="0 1 0"
                        range="0 120"/>

                    <geom
                        name="lower_leg_geom"
                        fromto="0 0 0 0 0 -0.5"
                        size="0.06"/>

                    <body
                        name="foot"
                        pos="0 0 -0.5">

                        <geom
                            name="foot_geom"
                            type="box"
                            pos="0.09 0 -0.03"
                            size="0.18 0.11 0.04"
                            mass="0.4"
                            rgba="0.25 0.25 0.25 1"/>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <position
            name="hip_motor"
            joint="hip_joint"
            kp="40"
            ctrlrange="-60 60"/>

        <position
            name="knee_motor"
            joint="knee_joint"
            kp="40"
            ctrlrange="0 110"/>
    </actuator>
</mujoco>